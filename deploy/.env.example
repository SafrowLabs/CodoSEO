# Environment for the CodoSEO compose files. Copy to .env next to the compose file you use.
# Variables the app reads are documented in docs/configuration.md; the ones here are the ones
# the compose files pass through. Lines left empty are treated as unset.

# ---------------------------------------------------------------------------------------------
# Self-hosting (compose.selfhost.yml)
# ---------------------------------------------------------------------------------------------

# Required. Encrypts stored channel secrets (webhook URLs, SMTP details): openssl rand -hex 32
SECRET_KEY=
# Required. Use letters and digits (it goes inside a postgres:// URL): openssl rand -hex 24
POSTGRES_PASSWORD=

# Image tag to run; pin a release (for example 0.1.0) for reproducible upgrades.
#CODOSEO_VERSION=latest
# Host port for the web app.
#CODOSEO_PORT=8080
# The URL people open the app at. Used in emails and links; set it behind a reverse proxy.
# Unset, it is http://localhost:$CODOSEO_PORT.
#BASE_URL=http://localhost:8080

# Optional: outgoing mail for sign-in links and alerts, e.g. smtps://user:pass@smtp.example.com:465
#SMTP_URL=
#MAIL_FROM=CodoSEO <alerts@example.com>
# Comma-separated emails that get the admin pages.
#ADMIN_EMAILS=
# Sign in with GitHub (OAuth app).
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
# Days of crawl history to keep (self-host).
#RETENTION_DAYS_SELFHOST=

# ---------------------------------------------------------------------------------------------
# Cloud layout (compose.cloud.yml): web + worker against an external Postgres
# ---------------------------------------------------------------------------------------------
# SECRET_KEY, BASE_URL (https) and SMTP_URL are required in cloud mode.

# Login role `codoseo` (see postgres-role.sql): worker and migrations.
#DATABASE_URL=postgres://codoseo:PASSWORD@db.internal:5432/codoseo
# Optional login role `codoseo_web` for the web container (statement_timeout 5s). Falls back to
# DATABASE_URL when unset.
#DATABASE_URL_WEB=postgres://codoseo_web:WEB_PASSWORD@db.internal:5432/codoseo

#TURNSTILE_SITE_KEY=
#TURNSTILE_SECRET=
# Umami analytics on the public pages (landing, bot page, audit report). Both are needed.
#UMAMI_SCRIPT_URL=https://analytics.example.com/script.js
#UMAMI_WEBSITE_ID=
# Where the client IP is read from behind your proxy (default CF-Connecting-IP).
#CLIENT_IP_HEADER=
# Public IP the crawler identifies from, shown to site owners.
#CODOSEO_BOT_IP=
#RANKORG_URL=https://rankorg.com
# Anonymous MCP limits and the client names allowed to share an IP.
#MCP_ANON_DAILY_AUDITS=200
#MCP_ANON_DAILY_EMAILS=200
#MCP_SHARED_CLIENTS=
# Billing (Dodo Payments). Leave unset to run without paid plans.
#DODO_ENV=
#DODO_API_KEY=
#DODO_API_URL=
#DODO_WEBHOOK_SECRET=
#DODO_PRODUCT_PRO=
#DODO_PRODUCT_AGENCY=
# Pinged after each scheduler tick (a heartbeat monitor URL). CODOSEO_SCHEDULER=off disables
# the scheduler in a role.
#SCHEDULER_HEARTBEAT_URL=
#CODOSEO_SCHEDULER=

# Logs and metrics. Logs are JSON lines in the cloud and plain text elsewhere; set
# CODOSEO_LOG_FORMAT=json|text to choose. RUST_LOG overrides the default filter "info,sqlx=warn".
#CODOSEO_LOG_FORMAT=
#RUST_LOG=
# Prometheus metrics at /metrics on this internal address (never on the public port). The cloud
# compose file sets 0.0.0.0:9090; leave unset to serve no metrics.
#CODOSEO_METRICS_BIND=0.0.0.0:9090
# Report errors and panics to Sentry. Nothing is sent without a DSN.
#SENTRY_DSN=
#SENTRY_ENVIRONMENT=
