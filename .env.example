# Copy this file to .env and fill in your values
# .env is gitignored — NEVER commit .env

# AWS SES SMTP Credentials
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=your_ses_smtp_username
SMTP_PASSWORD=your_ses_smtp_password
SMTP_FROM=noreply@codoseo.com

# Database
DATABASE_URL=postgres://user:password@localhost/codoseo

# No-key MCP tier (cloud only; leave unset for the defaults)
# Fresh audits agents may start per 24 hours over all of them (default 200)
# MCP_ANON_DAILY_AUDITS=200
# start_monitoring emails agents may trigger per 24 hours over all of them (default 200)
# MCP_ANON_DAILY_EMAILS=200
# User-Agent fragments of hosted connectors that skip the per-IP limits, comma separated (default claude-user,chatgpt,openai-mcp)
# MCP_SHARED_CLIENTS=claude-user,chatgpt,openai-mcp
